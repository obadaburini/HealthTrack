@model HelthTrack.ViewModels.LoginVM
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>HealthTrack – Login</title>

    <link rel="stylesheet" href="~/css/pages/account-login.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/healthtrack.css" asp-append-version="true" />
</head>

<body>

    <div class="card">

        @Html.ValidationSummary(false, "", new { @class = "error", role = "alert" })
        <div class="brand">
            <h2>HealthTrack</h2>
            <p>Choose account type, then login</p>
        </div>

        @if (TempData["Message"] != null)
        {
            <div class="alert-success">
                @TempData["Message"]
            </div>
        }

        @if (ViewBag.Message != null)
        {
            <div class="error">@ViewBag.Message</div>
        }

        @using (Html.BeginForm("Login", "Account", FormMethod.Post))
        {
            <input type="hidden" id="SelectedRole" name="SelectedRole" value="@Model.SelectedRole" />

            <div class="role-grid">
                <button type="button" class="role-card active" id="rolePatient" onclick="selectRole('Patient')">
                    Patient
                </button>

                <button type="button" class="role-card" id="roleDoctor" onclick="selectRole('Doctor')">
                    Doctor
                </button>
            </div>

            <div class="field">
                <label for="Username">Username</label>
                @Html.TextBoxFor(m => m.Username, new { placeholder = "Enter your username", required = "required" })
            </div>

            <div class="field">
                <label for="Password">Password</label>
                @Html.PasswordFor(m => m.Password, new { placeholder = "Enter your password", required = "required" })
            </div>

            <button class="btn" type="submit">Login</button>
        }

        <div class="footer">
            Don't have an account?
            <a href="/Account/Register">Register</a>
        </div>

    </div>

    <script>
        selectRole(document.getElementById("SelectedRole").value);
        function selectRole(role) {
            document.getElementById('SelectedRole').value = role;
            document.getElementById("rolePatient").setAttribute("aria-pressed", role === "Patient");
            document.getElementById("roleDoctor").setAttribute("aria-pressed", role === "Doctor");

            document.getElementById('rolePatient').classList.remove('active');
            document.getElementById('roleDoctor').classList.remove('active');

            if (role === 'Patient')
                document.getElementById('rolePatient').classList.add('active');
            else
                document.getElementById('roleDoctor').classList.add('active');
        }
    </script>

</body>
</html>
