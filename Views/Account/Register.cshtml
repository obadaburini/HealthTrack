@model HelthTrack.ViewModels.RegisterPatientVM
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>HealthTrack – Create Account</title>

    <link rel="stylesheet" href="~/css/pages/account-register.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/healthtrack.css" asp-append-version="true" />
</head>

<body>
    <div class="card">

        @Html.ValidationSummary(false, "", new { @class = "error", role = "alert" })
        <div class="brand">
            <h2>HealthTrack</h2>
            <p>Create your patient account</p>
        </div>

        @if (ViewBag.Message != null)
        {
            <div class="error">@ViewBag.Message</div>
        }

        @using (Html.BeginForm("RegisterPatient", "Account", FormMethod.Post))
        {
            <div class="field">
                <label for="FullName">Full Name</label>
                @Html.TextBoxFor(m => m.FullName, new {
                placeholder = "Enter your full name",
                        required = "required"
                        })
        </div>

        <div class="field">
            <label for="Email">Email</label>
            @Html.TextBoxFor(m => m.Email, new {
                        placeholder = "Enter your email address",
                        type = "email",
                        required = "required"
                        })
        </div>

        <div class="grid">
            <div class="field">
                <label for="DateOfBirth">Date of Birth</label>
                @Html.TextBoxFor(m => m.DateOfBirth, new {
                                type = "date",
                                required = "required"
                                })
            </div>

            <div class="field">
                <label for="Gender">Gender</label>
                @Html.DropDownListFor(
                                m => m.Gender,
                                new SelectList(new[]
                                {
                                new { Value = "Male", Text = "Male" },
                                new { Value = "Female", Text = "Female" }
                                }, "Value", "Text"),
                                "-- Select Gender --",
                                new { required = "required" }
                                )
            </div>
        </div>

        <div class="field">
            <label for="Disease">Disease</label>
            @Html.TextBoxFor(m => m.Disease, new {
                        placeholder = "e.g. Diabetes, Hypertension",
                        required = "required"
                        })
        </div>

        <div class="grid">
            <div class="field">
                <label for="Username">Username</label>
                @Html.TextBoxFor(m => m.Username, new {
                                placeholder = "Choose a username",
                                required = "required"
                                })
            </div>

            <div class="field">
                <label for="Password">Password</label>
                @Html.PasswordFor(m => m.Password, new {
                                placeholder = "Enter your password",
                                required = "required"
                                })
            </div>
        </div>

        <div class="field">
            <label for="ConfirmPassword">Confirm Password</label>
            <input type="password"
                   id="ConfirmPassword" name="ConfirmPassword" autocomplete="new-password" minlength="8"
                   placeholder="Re-enter your password"
                   required />
        </div>

        <button class="btn" type="submit">Create Account</button>
                }

        <div class="footer">
            Already have an account?
            <a href="/Account/Login">Login</a>
        </div>

    </div>
</body>
</html>
