@{
    Layout = null;

    var doctorName = Context.Session.GetString("UserName");
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta charset="UTF-8">
    <title>Doctor Dashboard - HealthTrack</title>

    <link rel="stylesheet" href="~/css/pages/doctor-dashboard_d.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/healthtrack.css" asp-append-version="true" />
</head>

<body>

    <div class="top-bar">
        <div>👨‍⚕️ Doctor: @doctorName</div>
        <form action="/Account/Logout" method="post" class="logout-form" asp-antiforgery="false">@Html.AntiForgeryToken()<button type="submit" class="logout">Logout</button></form>
    </div>

    <div class="container">
        <h1>Doctor Dashboard</h1>
        <p>Select an action:</p>

        <div class="card-container">

            <div class="card">
                <div class="card-title">📋 View Patients</div>
                <div class="card-text">Show all registered patients</div>
                <a href="/Doctor/Patients" class="btn">Open</a>
            </div>

            <div class="card">
                <div class="card-title">➕ Add Patient</div>
                <div class="card-text">Add a new patient to your list</div>
                <a href="/Doctor/AddPatient" class="btn">Add</a>
            </div>

            <div class="card">
                <div class="card-title">📊 Reports</div>
                <div class="card-text">View system and patient analytics</div>
                <a href="/Doctor/Reports" class="btn">View</a>

            </div>

        </div>
    </div>

</body>
</html>
