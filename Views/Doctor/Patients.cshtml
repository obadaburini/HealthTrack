@using Microsoft.AspNetCore.Http
@using System.Collections.Generic
@using System.Linq
@model IEnumerable<HelthTrack.Models.Patient>

@{
    Layout = null;
    var doctorName = Context.Session.GetString("UserName") ?? "Doctor";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>My Patients</title>

    <link rel="stylesheet" href="~/css/pages/doctor-patients.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/healthtrack.css" asp-append-version="true" />
</head>

<body>

    <header class="topbar">
        <div class="topbar-inner">
            <div>
                <div class="title">Doctor Dashboard</div>
                <div class="subtitle">Welcome, @doctorName</div>
            </div>

            <div class="actions">
                <a class="btn" href="/Doctor/Dashboard_D">⬅ Back</a>
                <form action="/Account/Logout" method="post" class="logout-form" asp-antiforgery="false">@Html.AntiForgeryToken()<button type="submit" class="btn btn-logout">Logout</button></form>
            </div>
        </div>
    </header>

    <main class="wrap">

        <section class="hero">
            <h2>My Patients</h2>
            <p>Simple and clean patients list.</p>
        </section>

        @if (Model == null || !Model.Any())
        {
            <div>No patients found.</div>
        }
        else
        {
            <section class="list">
                @foreach (var p in Model)
                {
                    <div class="card">
                        <div class="card-inner">

                            <div>
                                <p class="patient-name">@p.Name</p>
                                <div class="patient-id">Patient User ID: @p.PatientUserId</div>
                            </div>

                            <div class="badges">
                                <div class="badge"><strong>Age:</strong> @p.Age</div>

                                <div class="badge">
                                    <strong>Type:</strong>
                                    @if (p.PatientType == "Diabetes")
                                    {
                                        <span>Diabetic Patient</span>
                                    }
                                    else if (p.PatientType == "Heart")
                                    {

                                        <span>Heart Patient</span>
                                    }
                                    else if (p.PatientType == "Both")
                                    {

                                        <span>Diabetes + Heart</span>
                                    }
                                    else
                                    {

                                        <span>Not specified</span>
                                    }
                                </div>
                            </div>

                            <div class="actions">
                                <a class="btn" href="/Doctor/Details/@p.PatientUserId">Details</a>
                                <a class="btn" href="/Doctor/EditPatient?id=@p.PatientUserId">Edit</a>
                                <a class="btn btn-logout" href="/Doctor/DeletePatient?id=@p.PatientUserId">Delete</a>
                            </div>

                        </div>
                    </div>
                }
            </section>
        }

    </main>

</body>
</html>
