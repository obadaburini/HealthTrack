@model HelthTrack.Models.Patient

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>Confirm Delete</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <link rel="stylesheet" href="~/css/pages/doctor-deletepatient.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/healthtrack.css" asp-append-version="true" />
</head>

<body>

    <div class="card">
        <h3>Confirm Delete</h3>

        <p>
            Are you sure you want to remove this patient from your list?
            This action cannot be undone.
        </p>

        <div class="info">
            <div><strong>Name:</strong> @Model.PatientUser?.FullName</div>
            <div><strong>Username:</strong> @Model.PatientUser?.Username</div>
        </div>

        <form asp-controller="Doctor" asp-action="DeletePatient" method="post" asp-antiforgery="false">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@Model.PatientUserId" />

            <div class="actions">
                <a class="btn btn-cancel" asp-controller="Doctor" asp-action="Patients">
                    Cancel
                </a>

                <button type="submit" class="btn btn-danger">
                    Delete
                </button>
            </div>
        </form>
    </div>

</body>
</html>
