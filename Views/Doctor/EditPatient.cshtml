@model HelthTrack.Models.ViewModels.EditPatientVM

@{
    Layout = null;
    ViewData["Title"] = "Edit Patient";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>Edit Patient</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <link rel="stylesheet" href="~/css/pages/doctor-editpatient.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/healthtrack.css" asp-append-version="true" />
</head>

<body>

    <div class="card">
        <h2>Edit Patient</h2>

        <form asp-controller="Doctor" asp-action="EditPatient" method="post" asp-antiforgery="false">
            @Html.AntiForgeryToken()

            <input type="hidden" asp-for="PatientUserId" />

            <div class="hint">
                Age and weight are taken automatically from the patient account.
            </div>

            <div class="field">
                <label>Patient Type</label>
                <select asp-for="PatientType">
                    <option value="Diabetes">Diabetic Patient</option>
                    <option value="Heart">Heart Patient</option>
                    <option value="Both">Both (Diabetes + Heart)</option>
                </select>
                <span class="validation" asp-validation-for="PatientType"></span>
            </div>

            <div class="actions">
                <a class="btn" asp-controller="Doctor" asp-action="Patients">
                    Cancel
                </a>
                <button type="submit" class="btn btn-primary">
                    Save Changes
                </button>
            </div>
        </form>
    </div>

</body>
</html>
