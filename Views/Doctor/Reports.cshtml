@{
    Layout = null;
    var doctorName = Context.Session.GetString("UserName") ?? "Doctor";
}

<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta charset="utf-8" />
    <title>Reports</title>

    <link rel="stylesheet" href="~/css/pages/doctor-reports.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/healthtrack.css" asp-append-version="true" />
</head>

<body>

    <div class="top">
        <div>📊 Reports</div>
        <div>Welcome, @doctorName</div>
    </div>

    <div class="container">
        <h2>System Overview</h2>

        <div class="grid">
            <div class="box">
                <h2>@ViewBag.TotalPatients</h2>
                <p>Total Patients</p>
            </div>

            <div class="box">
                <h2>@ViewBag.DiabetesCount</h2>
                <p>Diabetes Patients (incl. Both)</p>
            </div>

            <div class="box">
                <h2>@ViewBag.HeartCount</h2>
                <p>Heart Patients (incl. Both)</p>
            </div>

            <div class="box">
                <h2>@ViewBag.BothCount</h2>
                <p>Both (Diabetes + Heart)</p>
            </div>

            <div class="box">
                <h2>@ViewBag.AvgAge</h2>
                <p>Average Age</p>
            </div>
        </div>

        <div class="back-wrapper">
            <a href="/Doctor/Dashboard_D" class="back-bottom">⬅ Back to Dashboard</a>
        </div>
    </div>

</body>
</html>
