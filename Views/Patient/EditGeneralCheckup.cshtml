@model HelthTrack.Models.GeneralCheckupRecord
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Edit General Checkup</title>
    <link rel="stylesheet" href="~/css/pages/patient-editgeneralcheckup.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/healthtrack.css" asp-append-version="true" />
</head>
<body>
    @if (TempData["Error"] is string error) { <div class="validation-banner" role="alert">@error</div> }
    <div class="card">
        <div class="h">Edit General Checkup</div>

        <form class="b" method="post" action="/Patient/EditGeneralCheckup" asp-antiforgery="false">
                @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@Model.Id" />

            <label for="date">Date</label>
            <input id="date" type="datetime-local" name="date" value="@Model.Date.ToString("yyyy-MM-ddTHH:mm")" required />

            <div class="grid">
                <div>
                    <label for="temperature">Temperature (°C)</label>
                    <input id="temperature" type="number" step="0.1" name="temperature" value="@Model.Temperature" required />
                </div>
                <div>
                    <label for="oxygenLevel">Oxygen (%)</label>
                    <input id="oxygenLevel" type="number" step="0.1" name="oxygenLevel" value="@Model.OxygenLevel" required />
                </div>
                <div>
                    <label for="respiratoryRate">Respiratory Rate</label>
                    <input id="respiratoryRate" type="number" step="1" name="respiratoryRate" value="@Model.RespiratoryRate" required />
                </div>
                <div>
                    <label for="weight">Weight (kg)</label>
                    <input id="weight" type="number" step="0.1" name="weight" value="@Model.Weight" required />
                </div>
                <div>
                    <label for="height">Height (cm)</label>
                    <input id="height" type="number" step="0.1" name="height" value="@Model.Height" required />
                </div>
            </div>

            <div class="actions">
                <a class="btn" href="/Patient/GeneralCheckup">Cancel</a>
                <button class="btn btn-primary" type="submit">Save</button>
            </div>
        </form>
    </div>
</body>
</html>
