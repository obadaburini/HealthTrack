@model HelthTrack.Models.BloodSugarRecord

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Edit Blood Sugar</title>

    <link rel="stylesheet" href="~/css/pages/patient-editbloodsugar.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/healthtrack.css" asp-append-version="true" />
</head>
<body>
    @if (TempData["Error"] is string error) { <div class="validation-banner" role="alert">@error</div> }
    <div class="card">
        <div class="h">Edit Blood Sugar Reading</div>

        <form class="b" method="post" action="/Patient/EditBloodSugar" asp-antiforgery="false">
                @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@Model.Id" />

            <div class="row">
                <label for="date">Date</label>
                <input id="date" type="datetime-local" name="date" value="@Model.Date.ToString("yyyy-MM-ddTHH:mm")" required />
            </div>

            <div class="row">
                <label for="sugarLevel">Sugar Level (mg/dL)</label>
                <input id="sugarLevel" type="number" step="0.1" name="sugarLevel" value="@Model.SugarLevel" required />
            </div>

            <div class="actions">
                <a class="btn" href="/Patient/BloodSugar">Cancel</a>
                <button class="btn btn-primary" type="submit">Save</button>
            </div>
        </form>
    </div>
</body>
</html>
