@model HelthTrack.Models.HeartRecord

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Edit Heart Vitals</title>

    <link rel="stylesheet" href="~/css/pages/patient-editheartvitals.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/healthtrack.css" asp-append-version="true" />
</head>
<body>
    @if (TempData["Error"] is string error) { <div class="validation-banner" role="alert">@error</div> }

    <div class="card">
        <h2>Edit Heart Vitals</h2>

        <form method="post" action="/Patient/EditHeartVitals" asp-antiforgery="false">
                @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@Model.Id" />

            <label for="date">Date</label>
            <input id="date" type="datetime-local"
                   name="date"
                   value="@Model.Date.ToString("yyyy-MM-ddTHH:mm")"
                   required />

            <label for="systolic">Systolic</label>
            <input id="systolic" type="number" name="systolic" value="@Model.Systolic" required />

            <label for="diastolic">Diastolic</label>
            <input id="diastolic" type="number" name="diastolic" value="@Model.Diastolic" required />

            <label for="heartRate">Heart Rate</label>
            <input id="heartRate" type="number" name="heartRate" value="@Model.HeartRate" required />

            <div class="actions">
                <a class="btn btn-ghost" href="/Patient/HeartVitals">Cancel</a>
                <button class="btn btn-primary" type="submit">Save</button>
            </div>
        </form>
    </div>

</body>
</html>
