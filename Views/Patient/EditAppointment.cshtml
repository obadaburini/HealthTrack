@model HelthTrack.Models.AppointmentRecord
@{
    Layout = null;
    var from = (ViewBag.From as string) ?? "DiabetesClinic";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Edit Appointment</title>
    <link rel="stylesheet" href="~/css/pages/patient-editappointment.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/healthtrack.css" asp-append-version="true" />
</head>
<body>
    @if (TempData["Error"] is string error) { <div class="validation-banner" role="alert">@error</div> }
    <div class="card">
        <div class="h">Edit Appointment</div>

        <form class="b" method="post" action="/Patient/EditAppointment" asp-antiforgery="false">
                @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@Model.Id" />
            <input type="hidden" name="from" value="@from" />

            <label for="date">Date</label>
            <input id="date" type="datetime-local" name="date" value="@Model.Date.ToString("yyyy-MM-ddTHH:mm")" required />

            <label for="description">Description</label>
            <input id="description" type="text" name="description" value="@Model.Description" required />

            <div class="actions">
                <a class="btn" href="/Patient/Appointments?from=@from">Cancel</a>
                <button class="btn btn-primary" type="submit">Save</button>
            </div>
        </form>
    </div>
</body>
</html>
