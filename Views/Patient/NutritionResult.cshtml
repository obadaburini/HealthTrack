@{
    Layout = null;
}

@model HelthTrack.Models.NutritionResult
@using Microsoft.AspNetCore.Http

@{
    var patientName = Context.Session.GetString("UserName") ?? "Patient";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta charset="utf-8" />
    <title>Nutrition Result</title>

    <link rel="stylesheet" href="~/css/Nutrition.css" />

    <link rel="stylesheet" href="~/css/pages/patient-nutritionresult.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/healthtrack.css" asp-append-version="true" />
</head>

<body>
    @if (TempData["Error"] is string error) { <div class="validation-banner" role="alert">@error</div> }

    <div class="top-bar">
        <div>🥗 Nutrition Clinic</div>
        <form action="/Account/Logout" method="post" class="logout-form" asp-antiforgery="false">@Html.AntiForgeryToken()<button type="submit" class="logout">Logout</button></form>
    </div>

    <div class="nutrition-container">
        <h2>Hello, @patientName</h2>
        <p>Your nutrition results are calculated below.</p>

        <div class="result-box">
            <h4 class="result-title">Results</h4>

            <div class="result-row">
                <span>Age</span>
                <span>@Model.Age</span>
            </div>

            <div class="result-row">
                <span>Gender</span>
                <span>@Model.Gender</span>
            </div>

            <div class="result-row">
                <span>BMI</span>
                <span>@Model.BMI.ToString("0.00")</span>
            </div>

            <div class="result-row">
                <span>Category</span>
                <span>@Model.Category</span>
            </div>

            <div class="result-row">
                <span>Goal</span>
                <span>@Model.Goal</span>
            </div>

            <div class="result-row">
                <span>BMR</span>
                <span>@Model.BMR.ToString("0") kcal/day</span>
            </div>

            <div class="result-row">
                <span>Recommended Calories</span>
                <span>@Model.DailyCalories.ToString("0") kcal/day</span>
            </div>

            <!-- ✅ Macros -->
            <div class="result-row">
                <span>Protein</span>
                <span>@Model.ProteinGrams.ToString("0") g/day</span>
            </div>

            <div class="result-row">
                <span>Carbs</span>
                <span>@Model.CarbsGrams.ToString("0") g/day</span>
            </div>

            <div class="result-row">
                <span>Fat</span>
                <span>@Model.FatGrams.ToString("0") g/day</span>
            </div>
        </div>

        <div class="buttons">
            <a asp-action="ExerciseTips"
               asp-route-category="@Model.Category"
               class="btn-ht">
                Exercise Tips
            </a>

            <a asp-action="FoodTips"
               asp-route-category="@Model.Category"
               class="btn-ht">
                Nutrition Tips
            </a>
        </div>

        <a class="back"
           asp-action="NutritionClinic"
           asp-controller="Patient">
            ← Back to Nutrition
        </a>
    </div>

</body>
</html>
