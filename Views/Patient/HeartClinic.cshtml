@using Microsoft.AspNetCore.Http
@{
    Layout = null;
    var patientName = Context.Session.GetString("UserName");
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta charset="utf-8" />
    <title>Heart Clinic</title>
    <link rel="stylesheet" href="~/css/pages/patient-heartclinic.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/healthtrack.css" asp-append-version="true" />
</head>
<body>
    @if (TempData["Error"] is string error) { <div class="validation-banner" role="alert">@error</div> }
    <div class="top-bar">
        <div>❤️ Heart Clinic</div>
        <form action="/Account/Logout" method="post" class="logout-form" asp-antiforgery="false">@Html.AntiForgeryToken()<button type="submit" class="logout">Logout</button></form>
    </div>

    <div class="container">
        <h2>Welcome, @patientName</h2>
        <p>Track your blood pressure and heart rate.</p>

        <div class="card">
            <h3>🩺 Blood Pressure & Heart Rate</h3>
            <p>Add readings and view classification + history.</p>
            <a class="btn" href="/Patient/HeartVitals">Open</a>
        </div>

        <div class="card">
            <h3>📅 Appointments</h3>
            <p>Manage heart clinic appointments.</p>
            <a class="btn" href="/Patient/Appointments?from=HeartClinic">View Appointments</a>
        </div>

        <a class="back" href="/Patient/Dashboard_P">← Back to Dashboard</a>
    </div>
</body>
</html>
