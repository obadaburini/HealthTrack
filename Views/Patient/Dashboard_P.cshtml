@using Microsoft.AspNetCore.Http
@{
    Layout = null;
    var patientName = Context.Session.GetString("UserName") ?? "Patient";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Patient Dashboard - HealthTrack</title>

    <link rel="stylesheet" href="~/css/pages/patient-dashboard_p.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/healthtrack.css" asp-append-version="true" />
</head>

<body>
    @if (TempData["Error"] is string error) { <div class="validation-banner" role="alert">@error</div> }

    <header class="topbar">
        <div class="topbar-inner">
            <div class="brand">
                <div>🏥 Patient Dashboard</div>
                <div>
                    <small>Hello, @patientName</small>
                </div>
            </div>
            <form action="/Account/Logout" method="post" class="logout-form" asp-antiforgery="false">@Html.AntiForgeryToken()<button type="submit" class="logout">Logout</button></form>
        </div>
    </header>

    <main class="wrap">

        <section class="hero">
            <h2>Welcome to HealthTrack</h2>
            <p>Select one of the clinics below to continue.</p>
        </section>

        <section class="grid">

            <!-- HEART -->
            <div class="card">
                <div class="card-b">
                    <div class="title">❤️ Heart Clinic</div>
                    <p class="desc">Blood pressure & heart monitoring basics.</p>

                    <div class="btn-row">
                        <a class="btn" href="/Patient/HeartClinic">Enter</a>
                    </div>
                </div>
            </div>

            <!-- DIABETES -->
            <div class="card">
                <div class="card-b">
                    <div class="title">🩸 Diabetes Clinic</div>
                    <p class="desc">Blood sugar tracking and diabetes care plan.</p>

                    <div class="btn-row">
                        <a class="btn" href="/Patient/DiabetesClinic">Enter</a>
                    </div>
                </div>
            </div>

            <!-- GENERAL -->
            <div class="card">
                <div class="card-b">
                    <div class="title">🩺 General Checkup</div>
                    <p class="desc">Basic health tests with quick feedback.</p>

                    <div class="btn-row">
                        <a class="btn" href="/Patient/GeneralCheckup">Enter</a>
                    </div>
                </div>
            </div>

            <!-- NUTRITION -->
            <div class="card">
                <div class="card-b">
                    <div class="title">🥗 Nutrition Clinic</div>
                    <p class="desc">BMI, diet planning, and activity insights.</p>

                    <div class="btn-row">
                        <a class="btn" href="/Patient/NutritionClinic">Enter</a>
                    </div>

                </div>
            </div>

        </section>
    </main>

</body>
</html>
