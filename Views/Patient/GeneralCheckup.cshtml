@using Microsoft.AspNetCore.Http
@using HelthTrack.Models
@using System.Collections.Generic
@using System.Linq

@{
    Layout = null;
    var patientName = Context.Session.GetString("UserName") ?? "Patient";

    double? temperature = ViewBag.Temperature;
    double? oxygenLevel = ViewBag.OxygenLevel;
    double? respiratoryRate = ViewBag.RespiratoryRate;

    var records = ViewBag.Records as List<GeneralCheckupRecord> ?? new List<GeneralCheckupRecord>();
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>General Checkup</title>

    <link rel="stylesheet" href="~/css/pages/patient-generalcheckup.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/healthtrack.css" asp-append-version="true" />
</head>

<body>
    @if (TempData["Error"] is string error) { <div class="validation-banner" role="alert">@error</div> }
    <header class="topbar">
        <div class="topbar-inner">
            <div class="brand">
                <div class="badge">🩺</div>
                <div>
                    General Checkup
                    <small>@patientName</small>
                </div>
            </div>

            <form action="/Account/Logout" method="post" class="logout-form" asp-antiforgery="false">@Html.AntiForgeryToken()<button type="submit" class="btn">Logout</button></form>
        </div>
    </header>

    <main class="container">
        <div class="header">
            <h2>Hello, @patientName</h2>
            <p>Enter your vital signs to get quick feedback.</p>
        </div>

        @using (Html.BeginForm("GeneralCheckup", "Patient", FormMethod.Post))
        {
            <div class="card">
                <h3 class="section-title">🩺 Add Reading</h3>

                <div class="field">
                    <label for="temperature">Temperature (°C)</label>
                    <input id="temperature" type="number" name="temperature" placeholder="e.g. 37.5" step="0.1" required />
                </div>

                <div class="field">
                    <label for="weight">Weight (kg)</label>
                    <input id="weight" type="number" name="weight" placeholder="e.g. 70" step="0.1" required />
                </div>

                <div class="field">
                    <label for="height">Height (cm)</label>
                    <input id="height" type="number" name="height" placeholder="e.g. 175" step="0.1" required />
                </div>

                <div class="field">
                    <label for="oxygenLevel">Oxygen (%)</label>
                    <input id="oxygenLevel" type="number" name="oxygenLevel" placeholder="e.g. 98" step="0.1" required />
                </div>

                <div class="field">
                    <label for="respiratoryRate">Breaths / min</label>
                    <input id="respiratoryRate" type="number" name="respiratoryRate" placeholder="e.g. 16" step="1" required />
                </div>

                @if (temperature != null || oxygenLevel != null || respiratoryRate != null)
                {
                    <hr style="border:none;border-top:1px solid var(--border); margin:16px 0;" />
                    <h3 class="section-title">Last Reading Feedback</h3>

                    @if (temperature != null)
                    {
                        if (temperature < 36.0)
                        {
                            <p class="status danger">⚠️ Low temperature.</p>
                        }
                        else if (temperature <= 37.5)
                        {

                            <p class="status ok">✅ Normal temperature (@temperature °C)</p>
                        }
                        else
                        {

                            <p class="status warn">⚠️ High temperature (@temperature °C).</p>
                        }
                    }

                    @if (oxygenLevel != null)
                    {
                        if (oxygenLevel < 90)
                        {
                            <p class="status danger">⚠️ Low oxygen (@oxygenLevel%).</p>
                        }
                        else
                        {

                            <p class="status ok">✅ Normal oxygen (@oxygenLevel%).</p>
                        }
                    }

                    @if (respiratoryRate != null)
                    {
                        if (respiratoryRate < 12 || respiratoryRate > 20)
                        {
                            <p class="status danger">⚠️ Abnormal RR (@respiratoryRate).</p>
                        }
                        else
                        {

                            <p class="status ok">✅ Normal RR (@respiratoryRate).</p>
                        }
                    }
                }

                <div class="actions">
                    <button type="submit" class="btn btn-primary">➕ Add Reading</button>
                    <a class="btn" href="/Patient/Dashboard_P">← Back to Clinics</a>
                </div>
            </div>
        }

        <!-- History + Actions -->
        <div class="card">
            <h3 class="section-title">History</h3>

            @if (!records.Any())
            {
                <div style="color:var(--muted); font-weight:800;">No records yet.</div>
            }
            else
            {
                <table>
                    <thead>
                        <tr>
                            <th style="width:220px;">Date</th>
                            <th>Temp</th>
                            <th>O2</th>
                            <th>RR</th>
                            <th>W</th>
                            <th>H</th>
                            <th style="width:180px;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in records)
                        {
                            <tr>
                                <td>@r.Date.ToString("yyyy-MM-dd HH:mm")</td>
                                <td>@r.Temperature</td>
                                <td>@r.OxygenLevel</td>
                                <td>@r.RespiratoryRate</td>
                                <td>@r.Weight</td>
                                <td>@r.Height</td>
                                <td>
                                    <a class="action-btn" href="/Patient/EditGeneralCheckup/@r.Id">Edit</a>

                                    <form method="post" action="/Patient/DeleteGeneralCheckup" style="display:inline;"
                                          onsubmit="return confirm('Delete this record?');" asp-antiforgery="false">
                @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@r.Id" />
                                        <button type="submit" class="action-btn action-danger">Delete</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>

    </main>
</body>
</html>
