@using Microsoft.AspNetCore.Http
@{
    Layout = null;
    var patientName = Context.Session.GetString("UserName") ?? "Patient";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta charset="utf-8" />
    <title>Diabetes Clinic</title>

    <link rel="stylesheet" href="~/css/pages/patient-diabetesclinic.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/healthtrack.css" asp-append-version="true" />
</head>

<body>
    @if (TempData["Error"] is string error) { <div class="validation-banner" role="alert">@error</div> }

    <!-- 🔴 Top Bar -->
    <div class="top-bar">
        <div>🩸 Diabetes Clinic</div>
        <form action="/Account/Logout" method="post" class="logout-form" asp-antiforgery="false">@Html.AntiForgeryToken()<button type="submit" class="logout">Logout</button></form>
    </div>

    <div class="container">
        <h2>Welcome, @patientName</h2>
        <p>This clinic helps you manage blood sugar and diabetes health.</p>

        <!-- Blood Sugar -->
        <div class="card">
            <h3>📊 Blood Sugar Tracking</h3>
            <p>Record and monitor your daily blood sugar levels.</p>
            <a class="btn" asp-controller="Patient" asp-action="BloodSugar">
                Add / View Blood Sugar
            </a>
        </div>

        <!-- Appointments -->
        <div class="card">
            <h3>📅 Appointments</h3>
            <p>Check your upcoming diabetes clinic appointments.</p>
            <a class="btn"
               asp-controller="Patient"
               asp-action="Appointments"
               asp-route-from="DiabetesClinic">
                View Appointments
            </a>
        </div>

        <!-- 🔙 Back to All Clinics -->
        <a class="back" href="/Patient/Dashboard_P">← Back to Clinics</a>
    </div>

</body>
</html>
